{
  "expo": {
    "name": "IRIS v2 Soccorritore",
    "slug": "iris-v2-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "android": {
      "package": "org.tuaassociazione.irisv2",
      "permissions": [
        "NOTIFICATIONS",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "WAKE_LOCK"
      ]
    },
    "ios": {
      "bundleIdentifier": "org.tuaassociazione.irisv2",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification", "location"]
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "sounds": ["./assets/attivazione_alta_priorita.wav"]
        }
      ]
    ]
  }
}
