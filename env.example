DATABASE_URL=postgresql://iris-v2:iris-v2_dev_password@localhost:5432/iris-v2
REDIS_URL=redis://localhost:6379
JWT_SECRET=cambia-questo-segreto-in-produzione
PORT=3000

# Timeout in secondi entro cui un mezzo deve confermare la ricezione
# di un'attivazione prima che scatti il fallback verso la centrale
ACTIVATION_TIMEOUT_SECONDS=60

# Credenziali Firebase Admin SDK per le push notification (JSON scaricato
# dalla console Firebase: Project Settings > Service Accounts)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
